# Copy to .env.local and fill in values

# Required: MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/your-db-name

# Required: Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=your-secret-at-least-32-chars-long

# Optional: Bypass password check for admin (e.g. support). Leave unset to disable.
# MASTER_PASSWORD=

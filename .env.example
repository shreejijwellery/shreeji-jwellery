# Copy to .env.local and fill in values

# Required: MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/your-db-name

# Required: Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=your-secret-at-least-32-chars-long

# Optional: Bypass password check for admin (e.g. support). Leave unset to disable.
# MASTER_PASSWORD=

# Optional: For SEO – your live site URL (e.g. https://yourdomain.com). Used for canonical URLs, Open Graph, and sitemap.
# NEXT_PUBLIC_SITE_URL=https://selleros.techshekhada.com

# Optional: Slack alerts when someone signs up or purchases a plan. Leave unset to disable.
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
